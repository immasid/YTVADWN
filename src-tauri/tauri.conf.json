{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseStream",
  "version": "0.1.0",
  "identifier": "com.pulsestream.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PulseStream",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Video",
    "shortDescription": "Authentic zero-transcoding desktop YouTube media downloader",
    "longDescription": "PulseStream is a high-performance desktop YouTube media downloader and lossless remuxing workstation with zero transcoding.",
    "resources": [
      "resources/binaries/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
